{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": " 󰑃 "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " DISTRO",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "├ ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "├ 󰏖",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "└ ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "uptime",
      "key": "󱎫 UPTIME",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "├ 󰋊",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "└ 󰍛",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "├ 󰢮",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "└ 󰍹",
      "keyColor": "green"
    },
    "break",
    "colors"
  ]
}
